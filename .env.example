# ============================================================================
# STILIZA DEVOTION - CONFIGURACIÓN PARA WHATSAPP REAL + IA (Copia a .env.local)
# ============================================================================

# 1. URL pública de tu servidor (necesaria para que WhatsApp reciba webhooks y descargue la imagen PNG del QR)
# Cuando pruebes en tu PC usa ngrok: `npx ngrok http 3000` y pega aquí la URL https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=https://tu-tunel.ngrok-free.app

# 2. INTELIGENCIA ARTIFICIAL (Elige una de las dos)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# OPENAI_API_KEY=sk-proj-xxxx

# 3. OPCIÓN A: META WHATSAPP CLOUD API (Gratis con número de prueba en developers.facebook.com)
WHATSAPP_VERIFY_TOKEN=stiliza_devotion_verify_2026
WHATSAPP_ACCESS_TOKEN=EAAGm0PX4ZCps...
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# 4. OPCIÓN B: TWILIO WHATSAPP SANDBOX (La más rápida para probar en 5 min desde tu celular)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
